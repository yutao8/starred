# ==========================================
# 基础配置
# ==========================================
# 要抓取的 GitHub 用户名
GITHUB_ACTOR=yutao8
# 你的 GitHub 个人访问令牌 (Token)
GH_TOKEN=

# ==========================================
# GPT 渠道配置 (多渠道互为备用)
# ==========================================

# 1. OpenRouter (主渠道推荐)
OPENROUTER_KEY=
# OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_MODELS=openai/gpt-4o-mini,qwen/qwen-plus-2025-07-28
# OPENROUTER_CONCURRENCY=10

# 2. DeepSeek (兜底渠道推荐)
DEEPSEEK_KEY=
# DEEPSEEK_URL=https://api.deepseek.com/chat/completions
# DEEPSEEK_MODELS=deepseek-v4-flash
# DEEPSEEK_CONCURRENCY=5

# 3. OpenAI (官方直连渠道)
# OPENAI_KEY=
# OPENAI_URL=https://api.openai.com/v1/chat/completions
# OPENAI_MODELS=gpt-5.6-luna
# OPENAI_CONCURRENCY=5

# 4. Custom (自定义 OpenAI 兼容接口)
# CUSTOM_KEY=
# CUSTOM_URL=https://your-api.example.com/v1/chat/completions
# CUSTOM_MODELS=your-model-name
# CUSTOM_CONCURRENCY=5

# ==========================================
# 代理配置 (如果你需要代理访问 GitHub 或 API)
# ==========================================
# CURL_PROXY=127.0.0.1:7890
# CURL_PROXY_TYPE=http
# CURL_IPRESOLVE_V4=true
CURL_TIMEOUT=20
CURL_CONNECT_TIMEOUT=5
CURL_MULTI_TIMEOUT=30

# ==========================================
# 抓取控制参数
# ==========================================
# 全局默认并发数 (当渠道未单独配置并发，或抓取 GitHub 列表时使用)
REQUEST_CONCURRENCY=10
# 可选：单独控制 GitHub 分页抓取并发；留空则使用 REQUEST_CONCURRENCY
# PAGE_CHUNK=

# 是否开启调试模式 (开启后只抓取 1 页/10 个仓库，且强制刷新 API)
DEBUG_MODE=false

# 分页控制
PAGE_START=1
PAGE_END=20
PAGE_LIMIT=100

# 生成页面展示控制
RECENT_LIMIT=10
LANG_LIMIT=10

# API 结果缓存时间 (秒，0 为永久缓存)
DESC_TIME=0
